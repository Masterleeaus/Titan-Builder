# Recommended location: ~/.openbrowser/.env
# Or set OPENBROWSER_CONFIG to an explicit config-file path.

# Bridge server port (default: 5000)
PORT=5000

# Above this character count, prompts are sent as a uniquely named text attachment
PROMPT_INJECTION_CHAR_LIMIT=40000

# High-privilege CLI/control token. Generated automatically when missing.
BRIDGE_TOKEN=

# Browser-extension token. Keep separate from BRIDGE_TOKEN and paste this value into the extension popup.
BRIDGE_BROWSER_TOKEN=

# Optional exact extension origins, comma-separated. When empty, the first authenticated extension origin is pinned until restart.
BRIDGE_EXTENSION_ORIGINS=

# Development-only missing-token bypass. Never enable for normal use.
OPENBROWSER_INSECURE_DEV=0

# Legacy arbitrary shell execution is disabled by default. Keep this at 0.
OPENBROWSER_ALLOW_UNSAFE_COMMANDS=0

# Maximum total wait for one browser-AI response (default: 15 minutes)
OPENBROWSER_RESPONSE_TIMEOUT_MS=900000

# Fail only after this much bridge inactivity; SSE heartbeats reset it (default: 3 minutes)
OPENBROWSER_RESPONSE_IDLE_TIMEOUT_MS=180000

# Recommended location: ~/.openbrowser/.env
# Or set OPENBROWSER_CONFIG to an explicit config-file path.

# Bridge server port (default: 5000)
PORT=5000

# Above this character count, prompts are sent as openbrowser-prompt.txt attachment
PROMPT_INJECTION_CHAR_LIMIT=40000

# Session auth token for browser extension ↔ bridge communication
BRIDGE_TOKEN=change-me-to-a-random-string

# Legacy arbitrary shell execution is disabled by default. Keep this at 0.
OPENBROWSER_ALLOW_UNSAFE_COMMANDS=0

# Maximum total wait for one browser-AI response (default: 15 minutes)
OPENBROWSER_RESPONSE_TIMEOUT_MS=900000

# Fail only after this much bridge inactivity; SSE heartbeats reset it (default: 3 minutes)
OPENBROWSER_RESPONSE_IDLE_TIMEOUT_MS=180000

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:titan-builder:schema:skill-manifest:v1",
  "title": "Titan Skill Manifest",
  "description": "Versioned contract for guidance, executable, orchestration, and adapter skills.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "status",
    "kind",
    "category",
    "description",
    "owner",
    "runtimeTargets",
    "inputs",
    "outputs",
    "dependencies",
    "capabilities",
    "risk",
    "approval",
    "tags"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1"
    },
    "id": {
      "type": "string",
      "pattern": "^titan\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 3,
      "maxLength": 120
    },
    "version": {
      "type": "string",
      "pattern": "^(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "status": {
      "enum": [
        "experimental",
        "stable",
        "deprecated"
      ]
    },
    "kind": {
      "enum": [
        "guidance",
        "executable",
        "orchestration",
        "adapter"
      ]
    },
    "category": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "maxLength": 1000
    },
    "owner": {
      "type": "string",
      "minLength": 2,
      "maxLength": 120
    },
    "runtimeTargets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "root",
          "cli",
          "extension-background",
          "extension-content",
          "extension-sidepanel",
          "workspace-companion",
          "git-hook",
          "github-actions"
        ]
      }
    },
    "entrypoint": {
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9_.-]+/)*[A-Za-z0-9_.-]+#[A-Za-z_$][A-Za-z0-9_$]*$"
    },
    "instructions": {
      "type": "string",
      "minLength": 20
    },
    "inputs": {
      "$ref": "#/$defs/objectSchema"
    },
    "outputs": {
      "$ref": "#/$defs/objectSchema"
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^titan\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
      }
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "filesystem.read",
          "filesystem.write",
          "process.execute",
          "network.read",
          "network.write",
          "browser.read",
          "browser.write",
          "git.read",
          "git.write",
          "storage.read",
          "storage.write",
          "secrets.read",
          "publish"
        ]
      }
    },
    "risk": {
      "enum": [
        "READ",
        "SAFE_EXECUTION",
        "WRITE",
        "NETWORK_WRITE",
        "ARBITRARY_EXECUTION",
        "DESTRUCTIVE",
        "PUBLISH"
      ]
    },
    "approval": {
      "enum": [
        "none",
        "explicit",
        "policy"
      ]
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "aliases": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minTitanVersion": {
          "type": "string",
          "pattern": "^(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
        },
        "platforms": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "linux",
              "windows",
              "macos",
              "browser"
            ]
          }
        },
        "providers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "deprecation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message"
      ],
      "properties": {
        "message": {
          "type": "string",
          "minLength": 1
        },
        "replacedBy": {
          "type": "string",
          "pattern": "^titan\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        }
      }
    }
  },
  "$defs": {
    "objectSchema": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "const": "object"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "guidance"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "instructions"
        ],
        "properties": {
          "risk": {
            "const": "READ"
          },
          "approval": {
            "const": "none"
          },
          "capabilities": {
            "maxItems": 0
          }
        },
        "not": {
          "required": [
            "entrypoint"
          ]
        }
      },
      "else": {
        "required": [
          "entrypoint"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "risk": {
            "enum": [
              "NETWORK_WRITE",
              "ARBITRARY_EXECUTION",
              "DESTRUCTIVE",
              "PUBLISH"
            ]
          }
        },
        "required": [
          "risk"
        ]
      },
      "then": {
        "properties": {
          "approval": {
            "enum": [
              "explicit",
              "policy"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "deprecated"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "deprecation"
        ]
      },
      "else": {
        "not": {
          "required": [
            "deprecation"
          ]
        }
      }
    }
  ]
}

{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "OpenBrowser Workspace: Install",
      "type": "shell",
      "command": "pnpm",
      "args": ["install", "--no-frozen-lockfile"],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "OpenBrowser Workspace: Start",
      "type": "shell",
      "command": "pnpm",
      "args": ["run", "dev"],
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "OpenBrowser Workspace: Stop Managed Process",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/openbrowser.ps1",
        "stop"
      ],
      "problemMatcher": []
    },
    {
      "label": "OpenBrowser Workspace: Register Folder",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/openbrowser.ps1",
        "register",
        "-ProjectPath",
        "${workspaceFolder}"
      ],
      "problemMatcher": []
    },
    {
      "label": "OpenBrowser Workspace: Index Project",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/openbrowser.ps1",
        "index"
      ],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "OpenBrowser Workspace: Analyze Project",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/openbrowser.ps1",
        "analyze"
      ],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "OpenBrowser Workspace: Analyze Current File",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-Command",
        "$root = (Invoke-RestMethod -Uri 'http://127.0.0.1:5010/health').activeProject.root; $relative = [IO.Path]::GetRelativePath($root, '${file}'); $headers = @{ Authorization = 'Bearer ' + $env:WORKSPACE_TOKEN }; $body = @{ path = $relative } | ConvertTo-Json -Compress; Invoke-RestMethod -Method Post -Uri 'http://127.0.0.1:5010/project/analyze-file' -Headers $headers -Body $body -ContentType 'application/json' | ConvertTo-Json -Depth 30"
      ],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "OpenBrowser Workspace: Send Clipboard Prompt",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-Command",
        "$prompt = Get-Clipboard -Raw; if (-not $prompt) { throw 'Clipboard is empty.' }; $headers = @{ Authorization = 'Bearer ' + $env:WORKSPACE_TOKEN }; $body = @{ prompt = $prompt; mode = 'ask' } | ConvertTo-Json -Compress; Invoke-RestMethod -Method Post -Uri 'http://127.0.0.1:5010/prompt' -Headers $headers -Body $body -ContentType 'application/json' | ConvertTo-Json -Depth 30"
      ],
      "group": "test",
      "problemMatcher": []
    }
  ]
}

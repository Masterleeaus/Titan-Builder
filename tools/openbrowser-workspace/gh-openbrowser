#!/usr/bin/env bash
set -euo pipefail

BASE_URL="${OPENBROWSER_WORKSPACE_URL:-http://127.0.0.1:5010}"

usage() {
  cat <<'USAGE'
Usage: gh openbrowser <command>

Commands:
  status                  Show workspace companion health
  register                Register the current repository
  review                  Review staged changes, or unstaged changes when nothing is staged
  analyze-pr <number>     Analyze a GitHub pull request diff
USAGE
}

require_command() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "Required command not found: $1" >&2
    exit 1
  fi
}

require_token() {
  if [[ -z "${WORKSPACE_TOKEN:-}" ]]; then
    echo "WORKSPACE_TOKEN is required for this command." >&2
    exit 1
  fi
}

api_json() {
  local method="$1"
  local route="$2"
  local payload="$3"
  require_token
  curl --fail-with-body --silent --show-error \
    --request "$method" \
    --header "Authorization: Bearer ${WORKSPACE_TOKEN}" \
    --header 'Content-Type: application/json' \
    --data-binary "$payload" \
    "${BASE_URL}${route}"
}

command_name="${1:-}"
case "$command_name" in
  status)
    require_command curl
    curl --fail-with-body --silent --show-error "${BASE_URL}/health" | {
      if command -v jq >/dev/null 2>&1; then jq .; else cat; fi
    }
    ;;

  register)
    require_command curl
    require_command jq
    project_root="$(pwd -P)"
    payload="$(jq -n --arg root "$project_root" '{root: $root}')"
    api_json POST '/projects/register-current' "$payload" | jq .
    ;;

  review)
    require_command curl
    require_command jq
    require_command git
    diff_text="$(git diff --cached --no-ext-diff --binary)"
    if [[ -z "$diff_text" ]]; then
      diff_text="$(git diff --no-ext-diff --binary)"
    fi
    if [[ -z "$diff_text" ]]; then
      echo 'No staged or unstaged changes to review.' >&2
      exit 1
    fi
    payload="$(jq -n --arg diff "$diff_text" '{diff: $diff}')"
    api_json POST '/code/review' "$payload" | jq .
    ;;

  analyze-pr)
    require_command curl
    require_command jq
    require_command gh
    pr_number="${2:-}"
    if [[ ! "$pr_number" =~ ^[1-9][0-9]*$ ]]; then
      echo 'Provide a positive pull request number.' >&2
      usage
      exit 1
    fi
    diff_text="$(gh pr diff "$pr_number")"
    payload="$(jq -n --arg diff "$diff_text" --argjson prNumber "$pr_number" '{diff: $diff, prNumber: $prNumber}')"
    api_json POST '/pr/analyze' "$payload" | jq .
    ;;

  *)
    usage
    exit 1
    ;;
esac

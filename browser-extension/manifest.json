{
  "manifest_version": 3,
  "name": "OpenBrowser Coding Bridge",
  "version": "0.5.0",
  "description": "Local browser-AI coding bridge with persistent projects, project memory, budgeted context, skills, profiles, exports, and safe automation.",
  "icons": {
    "32": "icons/favicon.png",
    "64": "icons/favicon.png",
    "128": "icons/favicon.png"
  },
  "permissions": [
    "activeTab",
    "alarms",
    "scripting",
    "storage",
    "tabs",
    "sidePanel"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://gemini.google.com/*",
    "https://chat.deepseek.com/*",
    "https://claude.ai/*",
    "https://www.perplexity.ai/*",
    "https://perplexity.ai/*",
    "https://chat.z.ai/*",
    "https://glm.ai/*",
    "https://open.bigmodel.cn/*",
    "https://grok.com/*",
    "https://x.com/*",
    "https://files.oaiusercontent.com/*",
    "https://*.oaiusercontent.com/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://gemini.google.com/*",
        "https://chat.deepseek.com/*",
        "https://claude.ai/*",
        "https://www.perplexity.ai/*",
        "https://perplexity.ai/*",
        "https://chat.z.ai/*",
        "https://glm.ai/*",
        "https://open.bigmodel.cn/*",
        "https://grok.com/*",
        "https://x.com/*"
      ],
      "js": [
        "src/providers.js",
        "src/chatgpt-page-tools.js",
        "src/content-script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "OpenBrowser",
    "default_icon": {
      "32": "icons/favicon.png",
      "64": "icons/favicon.png",
      "128": "icons/favicon.png"
    }
  },
  "side_panel": {
    "default_path": "src/sidepanel.html"
  }
}

# Workspace companion binds to loopback only.
WORKSPACE_HOST=127.0.0.1
WORKSPACE_PORT=5010

# Required for every non-health workspace request. Use at least 24 random characters.
WORKSPACE_TOKEN=

# Existing OpenBrowser bridge connection.
OPENBROWSER_BRIDGE_URL=http://127.0.0.1:5000
BRIDGE_TOKEN=

# Optional paths and tool overrides.
WORKSPACE_DB_PATH=
PYTHON_BIN=
RG_BIN=

# Hook behavior: 0 reports findings; 1 blocks on high-severity findings or analysis failure.
OPENBROWSER_HOOK_BLOCK=0

{
  "name": "@titan-builder/openbrowser-workspace",
  "version": "1.0.0",
  "description": "Secure local workspace companion for OpenBrowser and Titan Builder",
  "private": true,
  "type": "module",
  "main": "dist/bridge-server-entry.js",
  "scripts": {
    "dev": "tsx watch bridge-server-entry.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/bridge-server-entry.js",
    "db:init": "tsx seed-db.ts --schema-only",
    "db:seed": "tsx seed-db.ts",
    "test": "vitest run bridge-server.test.ts bridge-trust.test.ts bridge-instance-pinning.test.ts bridge-token-normalization.test.ts bridge-connection-transport.test.ts",
    "test:watch": "vitest bridge-server.test.ts bridge-connection-transport.test.ts",
    "test:python": "python -m unittest discover -s tests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify": "pnpm run typecheck && pnpm run test && pnpm run test:python && pnpm run build",
    "format": "prettier --write .",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.2.2",
  "dependencies": {
    "better-sqlite3": "^13.0.2",
    "chokidar": "^5.0.0",
    "dotenv": "^17.4.2",
    "fast-glob": "^3.3.3",
    "fastify": "^5.11.0",
    "ws": "^8.18.0",
    "yazl": "^3.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.14",
    "@types/yazl": "^3.3.1",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "openbrowser",
    "titan-builder",
    "workspace",
    "code-analysis",
    "local-first"
  ],
  "license": "MIT"
}

{
  "schemaVersion": "1",
  "id": "titan.security.project-path-containment",
  "name": "Project Path Containment",
  "version": "1.0.0",
  "status": "stable",
  "kind": "executable",
  "category": "security",
  "description": "Resolve project-relative paths while rejecting traversal, absolute paths, and filesystem escape.",
  "owner": "Titan Builder",
  "runtimeTargets": [
    "root"
  ],
  "entrypoint": "src/security/project-path.ts#resolveProjectPath",
  "inputs": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "projectRoot",
      "requestedPath"
    ],
    "properties": {
      "projectRoot": {
        "type": "string"
      },
      "requestedPath": {
        "type": "string"
      }
    }
  },
  "outputs": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "resolvedPath"
    ],
    "properties": {
      "resolvedPath": {
        "type": "string"
      }
    }
  },
  "dependencies": [],
  "capabilities": [
    "filesystem.read"
  ],
  "risk": "READ",
  "approval": "none",
  "tags": [
    "filesystem",
    "path-security"
  ],
  "compatibility": {
    "minTitanVersion": "0.5.0",
    "platforms": [
      "linux",
      "windows",
      "macos"
    ]
  }
}
